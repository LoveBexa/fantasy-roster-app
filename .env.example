# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Production — must include https:// (Vercel: Settings → Environment Variables)
NEXT_PUBLIC_SITE_URL=https://therosterleague.com

# Local dev only (optional; npm run dev defaults to http://localhost:3000 in the browser)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailchimp — The Workshop waitlist (server only; never expose in client code)
MAILCHIMP_API_KEY=your_mailchimp_api_key-us2
MAILCHIMP_AUDIENCE_ID=your_audience_list_id
